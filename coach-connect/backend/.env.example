# Copia questo file in .env (che git ignora) e personalizzalo.

# 1 = dati finti, per provare l'app senza account Garmin (usa data/demo.db)
GARMIN_DEMO=0

# Cartella dei token Garmin creati da `python -m coach_connect login`.
# Tienila FUORI dal repository: il repo è pubblico.
GARMIN_TOKEN_DIR=~/.garminconnect

# Database SQLite locale (default: data/garmin.db, oppure data/demo.db in modalità demo)
# DB_PATH=data/garmin.db

# Se impostato, l'app deve mandare "Authorization: Bearer <API_TOKEN>".
# Obbligatorio appena il backend è raggiungibile da fuori casa.
API_TOKEN=

# Origini web ammesse (CORS), separate da virgola
CORS_ORIGINS=*

# Attività per richiesta a Garmin e massimo di richieste per ogni "Aggiorna" dall'app
SYNC_PAGE_SIZE=50
SYNC_MAX_PAGES=20

# Parametri vitali: giorni tenuti aggiornati per il coach, e giorni mancanti scaricati
# al massimo a ogni "Aggiorna" (da riga di comando non c'è limite)
WELLNESS_DAYS=14
WELLNESS_MAX_DAYS_PER_SYNC=6

# Profilo per il coach (resta nel tuo .env, non nel repo)
ATHLETE_NAME=
ATHLETE_HEIGHT_CM=
# Usato se su Garmin non ci sono pesate (serve per calcolare i chin-up zavorrati)
ATHLETE_WEIGHT_KG=

# Coach AI gratuito: Ollama sul computer del backend (https://ollama.com), senza account né chiavi.
# Installa Ollama, poi per esempio: `ollama pull qwen3:8b` (16 GB di RAM) oppure `ollama pull qwen3:4b` (8 GB).
# Se OLLAMA_MODEL è vuoto si usa il primo modello da chat installato; senza Ollama il coach risponde offline.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=
OLLAMA_NUM_CTX=8192

# In alternativa, a pagamento: un servizio compatibile con le API OpenAI (se impostato, ha la precedenza su Ollama).
#   OpenAI: https://api.openai.com/v1 · Gemini: https://generativelanguage.googleapis.com/v1beta/openai
#   Anthropic: https://api.anthropic.com/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
