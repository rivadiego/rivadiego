# Copia in .env.local (ignorato da git). Le variabili EXPO_PUBLIC_ finiscono nel bundle dell'app.

# Indirizzo del backend. Se lo lasci vuoto, in sviluppo l'app usa lo stesso computer
# su cui gira Expo, porta 8000 (es. http://192.168.1.23:8000).
# Va impostato con "npx expo start --tunnel", con TestFlight o con il sito web pubblicato.
EXPO_PUBLIC_API_URL=

# Deve coincidere con API_TOKEN del backend (se impostato).
EXPO_PUBLIC_API_TOKEN=
