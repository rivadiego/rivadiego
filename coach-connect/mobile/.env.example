# Copia in .env.local (ignorato da git). Le variabili EXPO_PUBLIC_ finiscono nel bundle dell'app.

# Indirizzo del backend. Se lo lasci vuoto, in sviluppo l'app passa dal server di Expo, che inoltra /api
# al backend (metro.config.js, anche con --tunnel). Va impostato con TestFlight o con il sito web pubblicato.
EXPO_PUBLIC_API_URL=

# Deve coincidere con API_TOKEN del backend (se impostato).
EXPO_PUBLIC_API_TOKEN=
